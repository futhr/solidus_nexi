# Solidus encrypted preferences require exactly 32 secret bytes.
SOLIDUS_PREFERENCES_MASTER_KEY=replace-with-32-secret-bytes!!!!

# Test portal Secret key (not the Checkout key): Company -> Integration.
# Keep live values in a secret manager.
NEXI_CHECKOUT_API_KEY=replace-with-test-secret-key
# Generate with: openssl rand -hex 24
NEXI_CHECKOUT_WEBHOOK_SECRET=RandomAlphanumericSecret123

# Optional during a one-generation webhook-secret rotation.
NEXI_CHECKOUT_PREVIOUS_WEBHOOK_SECRET=

# Checkout configuration. Keep test until merchant verification is complete.
# The example hosts below are intentionally invalid; replace them with public pages you control.
NEXI_CHECKOUT_ENVIRONMENT=test
NEXI_CHECKOUT_COUNTRY=SWE
NEXI_CHECKOUT_TERMS_URL=https://shop.example/terms
NEXI_CHECKOUT_MERCHANT_TERMS_URL=https://shop.example/privacy
# Must be a public HTTPS origin with no path, query, or fragment. Reserved and private hosts are rejected.
NEXI_CHECKOUT_PUBLIC_BASE_URL=https://shop.example
